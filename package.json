{
  "name": "utilities",
  "private": true,
  "description": "Monorepo of small Node.js utility packages (@utility/*)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json",
    "test": "npm run build && node --test \"packages/*/test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.0"
  }
}
