{
  "name": "utilities",
  "private": true,
  "description": "Monorepo of small runtime-agnostic (Node.js, Deno, Bun) utility packages (@utility/*)",
  "license": "MIT",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "typecheck": "tsc -b && tsc -p tsconfig.check.json",
    "test": "npm run build && node --test \"packages/*/test/**/*.test.ts\"",
    "test:deno": "deno test --allow-read --allow-write --allow-run --allow-env --allow-net packages/",
    "test:bun": "bun test --timeout 30000 packages/",
    "test:all": "npm test && npm run test:deno && npm run test:bun"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "typescript": "^6.0.0"
  }
}
